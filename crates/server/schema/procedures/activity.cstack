part of "../corntchap.cstack"

// Agent activity: hooks of the agent runtimes report each edit or command (`corntchap-cli hook`).

/// Record what an agent session just did. Needs a registered station (`corntchap-cli station scan`).
/// @param runtime claude-code, opencode or codex.
/// @param session The runtime's own session id.
/// @param tool The tool that ran, e.g. Edit or Bash.
/// @param files Paths changed since the previous checkpoint (never contents).
/// @param checkpoint The git checkpoint taken after the tool, when there was one.
/// @param summary Short text: the command (truncated) or the file paths.
mutation procedure activityRecord(runtime: String, session: String, tool: String, files: String[], checkpoint: String?, summary: String?): ActivityResult
  @allow(auth() != null)

/// Recent agent activity in a pot, newest first.
/// @param project Pot key, e.g. PAY.
/// @param station Only this station.
/// @param task Only activity while a station held this task, e.g. PAY-12.
/// @param limit At most this many (default 50, max 200).
procedure activityList(project: String, station: String?, task: String?, limit: Int?): ActivityView[]
  @allow(auth() != null)
  @mcp(tool: "list_activity", description: "Recent agent activity in a pot, newest first: which station used which tool on which files, and the git checkpoint taken. Paths only, never contents.")
