part of "../corntchap.cstack"

// Task writes and the lease protocol: claim, heartbeat, check, comment, complete, release, block.

/// Create a task.
/// @param project Project key, e.g. PAY.
/// @param title One line saying what is to be done.
/// @param body Details in markdown: context, acceptance criteria.
/// @param items Checklist, one item per line.
/// @param parent Parent task id: this becomes a subtask, and the parent is not ready until its subtasks are done.
/// @param dependsOn Comma-separated task ids that must be done before this one is ready.
/// @param labels Comma-separated labels (claim_next can filter on them).
/// @param priority Higher is picked first by claim_next (default 0).
/// @param menu Menu (milestone) key to put the task on, e.g. mvp; see list_menus.
/// @param repos Comma-separated names of the pot's repositories the task is about (list_projects shows them); empty: any.
/// @param owner Handle of the task's owner: the person (or cook) of the pot's team accountable for it, whoever does the work.
mutation procedure taskCreate(project: String, title: String, body: String?, items: String?, parent: String?, dependsOn: String?, labels: String?, priority: Int?, menu: String?, repos: String?, owner: String?): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "create_task", description: "Create an open task. items: checklist, one item per line. dependsOn: comma-separated task ids that must be done first. labels: comma-separated. menu: the milestone key (list_menus). repos: comma-separated repository names of the pot, when the task is about specific repositories (claim_next gives it to cooks that handle one of them); leave out when it is not repo specific. owner: the handle of the person or cook of the pot's team who answers for the task (accountable, whoever does the work); my_work lists what you own.")

/// Edit a task's text, priority or labels.
/// @param id Task id, e.g. PAY-42.
/// @param title New title.
/// @param body New body (markdown).
/// @param priority New priority; higher is picked first.
/// @param labels Comma-separated; replaces the task's labels.
/// @param menu Menu key to move the task to; empty string takes it off its menu.
/// @param repos Comma-separated repository names of the pot; replaces the task's; empty string: any repository.
/// @param owner Handle of the owner (a person or cook of the pot's team); empty string clears the owner.
mutation procedure taskEdit(id: String, title: String?, body: String?, priority: Int?, labels: String?, menu: String?, repos: String?, owner: String?): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "update_task", description: "Edit title, body, priority, labels, repos (each comma-separated, replaces the set) or owner (a handle of the pot's team; empty clears). Not status. Agents may only edit a task they currently hold.")

/// Take the best ready task in a project.
/// @param project Project key, e.g. PAY.
/// @param labels Comma-separated: only accept tasks carrying one of these labels.
/// @param menu Only take tasks on this menu (key, e.g. mvp).
/// @param station Your station id (from the wake prompt), so the lease records this session.
/// @param ttlS Lease length in seconds for long work (default: the pot's lease TTL; at most 86400).
mutation procedure claimNext(project: String, labels: String?, menu: String?, station: String?, ttlS: Int?): ClaimResult
  @allow(auth() != null)
  @mcp(tool: "claim_next", description: "Atomically take the best ready task in a project. Returns the task and a lease {epoch, expires_at}, or {none: true}. Optional labels (comma-separated) restricts which tasks you accept. If your owner scoped you to some of the pot's repositories (set_cook_repos), only tasks about those, or about none, come to you. A task you released in the last 15 minutes is left to the other cooks, and a task with an open pull request is not handed out (the none reply names both; claim_task takes one by name). When the task's last lease lapsed without a release you get a `warning` and previous_lease: look for that work (branch, worktree, open pull request) before starting over. The lease lasts the pot's lease TTL; for long work pass ttlS (seconds, up to a day), and renew with heartbeat before anything that may outlast it (a long build or test run).")

/// Claim one named task.
/// @param id Task id, e.g. PAY-42.
/// @param station Your station id (from the wake prompt).
/// @param ttlS Lease length in seconds for long work (default: the pot's lease TTL; at most 86400).
mutation procedure claimTask(id: String, station: String?, ttlS: Int?): ClaimResult
  @allow(auth() != null)
  @mcp(tool: "claim_task", description: "Claim one named task. Returns the task and a lease {epoch, expires_at}. Pass ttlS (seconds, up to a day) when the work will take longer than the pot's lease TTL. A task outside your repository scope is still given to you, with a `warning`; so is a task with an open pull request (continue on its branch), or whose last lease lapsed without a release (see previous_lease).")

/// Extend a lease.
/// @param id Task id, e.g. PAY-42.
/// @param epoch The lease epoch claim_next / claim_task returned for this task.
/// @param ttlS New lease length in seconds (default: the project's lease TTL).
mutation procedure heartbeat(id: String, epoch: Int, ttlS: Int?): LeaseRenewal
  @allow(auth() != null)
  @mcp(tool: "heartbeat", description: "Extend your lease, by the pot's lease TTL or by ttlS seconds (up to a day). Any call carrying the epoch also extends it. Before a command that may outlast your lease (a long build, test suite or migration), heartbeat with a ttlS that covers it: a lease that runs out lets another cook take the task, and your next call gets lease_lost.")

/// Tick or untick a checklist item.
/// @param id Task id, e.g. PAY-42.
/// @param epoch The lease epoch claim_next / claim_task returned for this task.
/// @param position 1-based position of the item in the checklist.
/// @param done true to tick, false to untick.
mutation procedure checkItem(id: String, epoch: Int?, position: Int, done: Boolean): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "check_item", description: "Tick (or untick) checklist item `position` (1-based). Cooks pass their live lease epoch; people can tick without one.")

/// Comment on a task.
/// @param id Task id, e.g. PAY-42.
/// @param body The note, in markdown: progress, findings, a handoff for whoever picks it up next.
/// @param epoch Your lease epoch, if you hold the task: also extends the lease.
/// @param station Your own station (st_..., named in your wake prompt), so people see which of your sessions wrote it.
mutation procedure comment(id: String, body: String, epoch: Int?, station: String?): OkResult
  @allow(auth() != null)
  @mcp(tool: "comment", description: "Add a note or handoff to a task. No lease needed; pass epoch to also extend yours. The cook responsible for the task (holding it, parked on it, or the one that last held it) is woken with the comment, and so are cooks you @mention; you never wake yourself.")

/// Finish a task.
/// @param id Task id, e.g. PAY-42.
/// @param epoch The lease epoch claim_next / claim_task returned for this task.
/// @param result What you did and where: summary, PR or commit links, follow-ups.
/// @param noPropagate true when nothing downstream is affected: do not tell the cooks of repositories that depend on this task's repositories.
mutation procedure complete(id: String, epoch: Int, result: String, noPropagate: Boolean?): TaskView
  @allow(auth() != null)
  @mcp(tool: "complete", description: "Mark the task done. Fails with lease_lost if the epoch is stale: then stop and report, your work is not counted. When the task names repositories that others depend on (link_repo), their cooks are told (or a follow-up task is opened for them); pass noPropagate=true when you know nothing downstream is affected.")

/// Give a task back.
/// @param id Task id, e.g. PAY-42.
/// @param epoch The lease epoch claim_next / claim_task returned for this task.
/// @param reason Why, and what the next agent should know.
mutation procedure release(id: String, epoch: Int, reason: String): TaskView
  @allow(auth() != null)
  @mcp(tool: "release", description: "Give the task back (status open) for someone else.")

/// Block a task until a human looks at it.
/// @param id Task id, e.g. PAY-42.
/// @param epoch The lease epoch claim_next / claim_task returned for this task.
/// @param reason What is blocking and what you need from a human.
mutation procedure block(id: String, epoch: Int, reason: String): TaskView
  @allow(auth() != null)
  @mcp(tool: "block", description: "Mark the task blocked; it waits for a human to unblock it.")

/// Split a task that names several repositories into one subtask per repository.
/// @param id Task id, e.g. PAY-42; it must be open and name repositories (repos).
mutation procedure taskSplitByRepo(id: String): SplitResult
  @allow(auth() != null)
  @mcp(tool: "split_by_repo", description: "Split an open task that names several repositories (repos) into one subtask per repository, each with that single repository and the title prefixed [name], so each repository's cook takes its part. The task waits for its subtasks; running it again adds only the missing parts.")

/// Link a pull request to a task.
/// @param id Task id, e.g. PAY-42.
/// @param url The pull request's address, e.g. https://github.com/acme/shop/pull/12.
mutation procedure taskLinkPr(id: String, url: String): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "link_pr", description: "Link a pull request (its web address, e.g. https://github.com/acme/shop/pull/12) to a task. A link made here wins over the automatic ones (the task's id in the branch, the title or the body). The task then shows the pull request's state, checks and reviews, and its holder is told about failed checks, requested changes and comments. A merge never changes the task's status. The pull request is read from GitHub at once (title, state, branch, checks, review) when the GitHub App is installed on its repository; otherwise the answer has a `warning`.")

/// Read a task's pull requests from GitHub again.
/// @param id Task id, e.g. PAY-42.
/// @param url One pull request's address; leave out to refresh all of the task's pull requests.
mutation procedure taskRefreshPr(id: String, url: String?): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "refresh_pr", description: "Read the pull requests linked to a task from GitHub again (title, state, branch, checks, review, conflicts), through the GitHub App installed on their repository. link_pr does this once when it links. A `warning` says when the app is not installed on the repository.")

/// Take a pull request off a task.
/// @param id Task id, e.g. PAY-42.
/// @param url The pull request's address; leave out to unlink all of the task's pull requests.
mutation procedure taskUnlinkPr(id: String, url: String?): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "unlink_pr", description: "Take a pull request off a task (all of its pull requests when url is left out). Automatic linking leaves it unlinked afterwards.")
