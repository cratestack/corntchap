part of "../corntchap.cstack"

// Task writes and the lease protocol: claim, heartbeat, check, comment, complete, release, block.

mutation procedure taskCreate(project: String, title: String, body: String?, items: String?, parent: String?, dependsOn: String?, labels: String?, priority: Int?): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "create_task", description: "Create an open task. items: checklist, one item per line. dependsOn: comma-separated task ids that must be done first. labels: comma-separated.")

mutation procedure taskEdit(id: String, title: String?, body: String?, priority: Int?, labels: String?): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "update_task", description: "Edit title, body, priority or labels (labels is comma-separated and replaces the set). Not status. Agents may only edit a task they currently hold.")

mutation procedure claimNext(project: String, labels: String?): ClaimResult
  @allow(auth() != null)
  @mcp(tool: "claim_next", description: "Atomically take the best ready task in a project. Returns the task and a lease {epoch, expires_at}, or {none: true}. Optional labels (comma-separated) restricts which tasks you accept.")

mutation procedure claimTask(id: String): ClaimResult
  @allow(auth() != null)
  @mcp(tool: "claim_task", description: "Claim one named task. Returns the task and a lease {epoch, expires_at}.")

mutation procedure heartbeat(id: String, epoch: Int, ttlS: Int?): LeaseRenewal
  @allow(auth() != null)
  @mcp(tool: "heartbeat", description: "Extend your lease. Any call carrying the epoch also extends it, so you rarely need this.")

mutation procedure checkItem(id: String, epoch: Int, position: Int, done: Boolean): TaskDetail
  @allow(auth() != null)
  @mcp(tool: "check_item", description: "Tick (or untick) checklist item `position` (1-based). Needs your live lease epoch.")

mutation procedure comment(id: String, body: String, epoch: Int?): OkResult
  @allow(auth() != null)
  @mcp(tool: "comment", description: "Add a note or handoff to a task. No lease needed; pass epoch to also extend yours.")

mutation procedure complete(id: String, epoch: Int, result: String): TaskView
  @allow(auth() != null)
  @mcp(tool: "complete", description: "Mark the task done. Fails with lease_lost if the epoch is stale: then stop and report, your work is not counted.")

mutation procedure release(id: String, epoch: Int, reason: String): TaskView
  @allow(auth() != null)
  @mcp(tool: "release", description: "Give the task back (status open) for someone else.")

mutation procedure block(id: String, epoch: Int, reason: String): TaskView
  @allow(auth() != null)
  @mcp(tool: "block", description: "Mark the task blocked; it waits for a human to unblock it.")
