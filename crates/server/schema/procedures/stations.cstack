part of "../corntchap.cstack"

// Stations: registered agent sessions (src/stations.rs). `corntchap-cli station scan` registers
// the sessions it finds in a checkout and its worktrees.

/// Register an agent session as a station of a cook in a pot.
/// @param project Pot key, e.g. PAY.
/// @param runtime opencode, claude-code, codex, copilot, antigravity or other.
/// @param session The runtime's own session id.
/// @param cook The cook it works as (default: you, when a cook registers its own session).
/// @param directory Where the session works on its machine.
/// @param label A short name shown in the console, e.g. ai-helm (feature-x).
/// @param repo The pot's repository (its alias) the directory is a checkout of.
/// @param confined true when the session cannot leave its folder (a sandbox, a harness locked to one directory): claim_next hands it only tasks about its repo or about none.
mutation procedure stationRegister(project: String, runtime: String, session: String, cook: String?, directory: String?, label: String?, repo: String?, confined: Boolean?): StationView
  @allow(auth() != null)
  @mcp(tool: "register_station", description: "Register an agent session as a station of a cook in a pot, so wakes resume that very session. Usually done by `corntchap-cli station scan`; a cook that knows its own session id can register itself. Say confined=true when you cannot leave your folder. The answer carries the pot's guide (how we work here) and what_now tells you what to do next.")

/// Stations you can see.
/// @param project Only this pot.
/// @param cook Only this cook.
/// @param kind session (registered agent sessions) or cloud-run (one station per cloud run, ended ones too). Without it: the sessions and the cloud runs still going.
/// @param live true: only sessions and cloud runs that have not ended; false: only ended cloud runs.
/// @param limit With kind cloud-run: how many of the newest runs (default 100, at most 500).
procedure stationList(project: String?, cook: String?, kind: String?, live: Boolean?, limit: Int?): StationView[]
  @allow(auth() != null)
  @mcp(tool: "list_stations", description: "Registered agent sessions (stations): yours as a cook, or those of the cooks you own, with the tasks each holds or waits on.")

/// Remove a station.
/// @param id Station id, e.g. st_1a2b3c4d5e.
mutation procedure stationRemove(id: String): OkResult
  @allow(auth() != null)
  @mcp(tool: "remove_station", description: "Forget a registered session (station).")

/// Make a station its cook's main one in its pot, or stop it being the main one.
/// @param id Station id, e.g. st_1a2b3c4d5e.
/// @param main true (default) to make it the main station, false to unset it.
mutation procedure stationSetMain(id: String, main: Boolean?): StationView
  @allow(auth() != null)
  @mcp(tool: "set_main_station", description: "Choose the session that answers a cook's messages, mentions and question answers in a pot (its main station); without one, the session woken last answers. At most one per cook and pot: setting one unsets the previous.")

/// Start a new agent session for a cook in a pot, in a folder where it already has a station.
/// The cook's relay runs it on its machine and the session becomes a station.
/// @param project Pot key, e.g. PAY.
/// @param cook The cook it works as (default: you, when a cook starts a session of its own).
/// @param task A task it should take, e.g. PAY-12.
/// @param prompt What to tell the session, on top of the task.
/// @param directory The folder, one of the cook's station folders in that pot (default: its main station's).
/// @param label A short name shown in the console.
mutation procedure stationStart(project: String, cook: String?, task: String?, prompt: String?, directory: String?, label: String?): StationView
  @allow(auth() != null)
  @mcp(tool: "start_station", description: "Start a new Claude Code session for a cook in a pot, in a folder where the cook already has a station (its relay runs it with `claude -p` on that machine). The session becomes a new station; give it a task to take and/or a prompt.")
