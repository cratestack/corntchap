part of "../corntchap.cstack"

// What a station should do now, and the pot's guide.

/// What should this station do now?
/// @param project Pot key, e.g. PAY.
/// @param station Your station id (st_...): the briefing is for that session's folder and repository.
procedure whatNow(project: String, station: String?): WhatNowView
  @allow(auth() != null)
  @mcp(tool: "what_now", description: "What to do now, for you and your station in a pot: what you hold, what waits on you, ready tasks for your folder's repo, ready tasks in the pot's other repositories (with the url to clone), work that needs no checkout, the pot's guide, and `next`: one sentence. Call it when you start, when you are idle and when asked what you are doing. Never answer 'nothing to do' while it lists something.")

/// Set a pot's guide: how we work here, for agents (markdown).
/// @param project Pot key, e.g. PAY.
/// @param guide The guide, markdown, at most 20000 characters; empty clears it.
mutation procedure setPotGuide(project: String, guide: String): PotGuide
  @allow(auth() != null)
  @mcp(tool: "set_pot_guide", description: "Set a pot's guide, the text agents read to learn how we work here (markdown, at most 20000 characters; empty clears it). Owners of the pot's team and admins. what_now returns it, and register_station and whoami carry its start.")
