part of "../corntchap.cstack"

// What corntchap sends to agents (src/usage.rs).

/// Text corntchap sent to agents: tool results, tool listings and wake prompts. An estimate.
/// @param project Only this pot (key, e.g. PAY).
/// @param cook Only this cook.
/// @param days How many days back, today included (default 7, at most 90).
procedure usageReport(project: String?, cook: String?, days: Int?): UsageReport
  @allow(auth() != null)
  @mcp(tool: "usage_report", description: "How much text corntchap sent to agents (yours, or those of the cooks you own): calls, characters and estimated tokens (chars / 4) for the last days, per day, and the top tools and wake reasons. It counts what corntchap sends, not what the agent itself uses.")

/// A page of the cooks whose usage you may see, the biggest senders first.
/// @param project Only this pot (key, e.g. PAY).
/// @param days How many days back, today included (default 7, at most 90).
/// @param q Only cooks whose name contains this (any case).
/// @param page limit (default 25, at most 200) and cursor.
procedure usageCookPage(project: String?, days: Int?, q: String?, page: CursorPageInput?): CursorPage<UsageCook>
  @allow(auth() != null)
  @mcp(tool: "usage_by_cook", description: "The cooks whose usage you may see (yours, or those of the cooks you own), the biggest receivers first, a page at a time (items, nextCursor): calls, characters and estimated tokens (chars / 4) of what corntchap sent each one over the last days. Narrow with project, days or q (a cook's name). usage_report gives the totals, per day and the top tools.")
