part of "../corntchap.cstack"

// What corntchap sends to agents (src/usage.rs).

/// Text corntchap sent to agents: tool results, tool listings and wake prompts. An estimate.
/// @param project Only this pot (key, e.g. PAY).
/// @param cook Only this cook.
/// @param days How many days back, today included (default 7, at most 90).
procedure usageReport(project: String?, cook: String?, days: Int?): UsageReport
  @allow(auth() != null)
  @mcp(tool: "usage_report", description: "How much text corntchap sent to agents (yours, or those of the cooks you own): calls, characters and estimated tokens (chars / 4) for the last days, per day, per cook, and the top tools and wake reasons. It counts what corntchap sends, not what the agent itself uses.")

/// A page of the cooks whose usage you may see, the biggest senders first.
/// @param project Only this pot (key, e.g. PAY).
/// @param days How many days back, today included (default 7, at most 90).
/// @param q Only cooks whose name contains this (any case).
/// @param page limit (default 25, at most 200) and cursor.
procedure usageCookPage(project: String?, days: Int?, q: String?, page: CursorPageInput): CursorPage<UsageCook>
  @allow(auth() != null)
