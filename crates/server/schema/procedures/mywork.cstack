part of "../corntchap.cstack"

// What the signed-in principal owns, holds and is waited on for.

/// What do I own, hold and wait on, across my pots?
/// @param project Only this pot (key, e.g. PAY); empty: every pot you can see.
procedure myWork(project: String?): MyWorkView
  @allow(auth() != null)
  @mcp(tool: "my_work", description: "What is yours across every pot you can see: `owned` (open, claimed and blocked tasks you are accountable for, by pot), `holding` (tasks you hold with a live lease), `waiting_on_me` (questions addressed to you, reviews asked of you or of the team, unanswered comments on your tasks; people also see the open questions nobody picked), `blocked_on_me` (tasks parked on a question you must answer, or depending on a task you own) and `counts`. A task's owner is the person accountable for it, whoever does the work: set it with create_task / update_task owner. what_now is the same for one pot and your station.")

/// A page of one section of what you own or hold: highest priority first, then pot and number.
/// @param section owned (open, claimed and blocked tasks you own), holding (tasks you hold with a live lease) or blocked (tasks parked on a question you must answer, or depending on a task you own).
/// @param project Only this pot (key, e.g. PAY).
/// @param page limit (default 25, at most 200) and cursor.
procedure myWorkPage(section: String, project: String?, page: CursorPageInput): CursorPage<WorkTask>
  @allow(auth() != null)

/// A page of the questions waiting on you, oldest first.
/// @param project Only this pot (key, e.g. PAY).
/// @param pool People: the open questions in your pots that nobody picked, instead of those addressed to you.
/// @param page limit (default 25, at most 200) and cursor.
procedure myWorkQuestionPage(project: String?, pool: Boolean?, page: CursorPageInput): CursorPage<WorkQuestion>
  @allow(auth() != null)

/// A page of the reviews waiting on you: those named to you first, then those asked of anyone on the team.
/// @param project Only this pot (key, e.g. PAY).
/// @param page limit (default 25, at most 200) and cursor.
procedure myWorkReviewPage(project: String?, page: CursorPageInput): CursorPage<WorkReview>
  @allow(auth() != null)

/// A page of the people's comments on tasks a cook holds that it has not answered, oldest first (empty for a person).
/// @param project Only this pot (key, e.g. PAY).
/// @param page limit (default 25, at most 200) and cursor.
procedure myWorkCommentPage(project: String?, page: CursorPageInput): CursorPage<WorkComment>
  @allow(auth() != null)
