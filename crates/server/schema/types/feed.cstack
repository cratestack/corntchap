part of "../corntchap.cstack"

// The change feed (changes_since, wait_for_work).

// The keys the event kinds put in `payload` (an open-ended object in the table; task.created's
// `labels` list is not part of the typed view, read it through the Event model).
type ChangePayload {
  title String?
  agent String?
  epoch Int?
  position Int?
  done Boolean?
  result String?
  reason String?
  /// memory.saved / memory.forgotten: the memory's key.
  key String?
  /// memory.saved: true when the memory was new.
  created Boolean?
  /// menu.* events and task.created: the menu's key.
  menu String?
  /// question.* events: the question id, e.g. PAY-Q3.
  question String?
  /// question.answered: the answer (first line).
  answer String?
  /// question.answered: the cook that relayed the answer.
  relayed_by String?
  /// question.asked: who it is addressed to.
  to String?
  /// pass.posted: the cook that posted it in its owner's name; forge.linked: branch, title or body.
  via String?
  /// file.* events: the file id, e.g. PAY-F12.
  file String?
  /// file.ready: the file's permanent link.
  url String?
  /// project.repo_added / project.repo_removed: the repository's name.
  name String?
  /// project.repo_linked: the dependent repository and the one it depends on.
  repo String?
  depends_on String?
  /// task.propagated: the repositories of the served task that others depend on, comma separated.
  upstream String?
  /// forge.* events: the pull request's number (its repository is `repo`, `owner/name`).
  number Int?
  /// forge.pr: opened, reopened, closed or updated.
  action String?
  /// forge.checks: success, failure, timed_out or cancelled.
  conclusion String?
  /// forge.checks: the failing checks, comma separated.
  failing String?
  /// forge.review and forge.comment: who wrote it, and the start of what they wrote.
  author String?
  /// review.done: the start of the verdict body.
  excerpt String?
  /// forge.review: approved, changes_requested or commented.
  review String?
  /// forge.comment: the file and line of an inline comment.
  path String?
  line Int?
  /// review.* events: the review id, e.g. PAY-R3.
  review_id String?
  /// review.requested: who was asked (empty: anyone on the team).
  reviewer String?
  /// review.*: which time the task is reviewed (1, 2, ...).
  round Int?
  /// review.requested: what to look at (first line).
  note String?
  /// review.done: approved, changes_requested or commented.
  verdict String?
  /// task.owner_changed: the owner before and after (handles; absent: nobody).
  old_owner String?
  new_owner String?
  /// restaurant events (the server's own decisions): the sentence the server built. task.lease_expired,
  /// task.blocked, task.completed, forge.linked and forge.backfill carry `why` and a `reason` code.
  why String?
  /// restaurant.decided: wake.held, wake.capped, wake.withheld, claim.skipping, catch_up, merge.kept_open, run.ended or role.kept.
  decision String?
  /// restaurant.decided: the sentence.
  text String?
  /// restaurant.decided and wakes: the cook's id, and its station when there is one.
  agent_id String?
  station String?
  /// restaurant.decided: the task it is about (e.g. PAY-3).
  task String?
  /// restaurant.decided wake.held: no wake before this time.
  until String?
  /// restaurant.decided: wakes in a row without a claim.
  misses Int?
  /// wake.failed: why the delivery failed; wake.delivered and wake.failed: the kind of target.
  error String?
  type String?
  /// restaurant.decided: how many times the same decision was left unsaid since the last one.
  repeated Int?
}

type ChangeView {
  seq Int
  kind String
  project String
  task String?
  /// A person, a cook, a fire or `restaurant` (the server itself: its events are decisions with a reason).
  actor String?
  /// user, agent, relay or restaurant; absent for forge events (GitHub did it).
  actor_kind String?
  at String
  payload ChangePayload
}

type ChangeFeed {
  events ChangeView[]
  next_cursor Int
  /// There are older events than the first one returned (read them with `before`).
  older Boolean
}

/// A task you could claim now (wait_for_work). Read it in full with get_task.
type ReadyTask {
  /// Task id, e.g. PAY-42.
  id String
  project String
  title String
  /// Higher is picked first by claim_next.
  priority Int
  labels String[]
}

type WaitResult {
  /// Claimable tasks, best first (at most 20); empty when the wait timed out.
  ready ReadyTask[]
}
