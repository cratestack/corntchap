part of "../corntchap.cstack"

// The pass (src/pass.rs).

/// One message on a pot's pass, or a direct one.
type PassMessageView {
  id String
  /// Order of the message in the whole kitchen; pass it as `after` to read only what came next.
  seq Int
  project String
  /// Who it is from: a cook, or a person whose cook relayed it (see via).
  from String?
  /// user or agent.
  from_kind String?
  /// The cook that posted it in its owner's name.
  via String?
  /// The recipient of a direct message (only its sender and recipient read it); absent on the pass.
  to String?
  body String
  /// The task it is about, e.g. PAY-42.
  task String?
  at String
  /// Who posting it woke, kept with the message: each cook, and the session (station) it reached.
  /// Set on the message you just posted when a fire-and-forget cook was involved: it was started by its owner's message and does not stay to chat, it was not woken (a mention; it only takes ready work), or no cloud target of it serves the pot.
  note String?
  woken WokenRef[]
  /// The session (station) that wrote it, when the cook said which: a cook can run several.
  station String?
  /// That session's label (its folder or title), e.g. "quiet-planet: payments".
  station_label String?
  /// The one session a direct message was sent to (to: st_...), and its label.
  to_station String?
  to_station_label String?
}

/// Unread messages in a direct conversation.
type PassUnreadDirect {
  /// The other chef.
  chef String?
  count Int
}

type PassUnread {
  /// Unread on the pot's pass.
  pot Int
  /// Your direct conversations in the pot, the most recent first, with their unread count (0 when read).
  direct PassUnreadDirect[]
}

/// A page of the pass, oldest first.
type PassPage {
  messages PassMessageView[]
  /// The newest seq returned: pass it as `after` next time.
  cursor Int
  /// What is still unread after this read.
  unread PassUnread
}

/// A cook (and the session) a pass message woke.
type WokenRef {
  cook String
  /// The station woken, e.g. st_1ab1f38788 (absent: the cook's wake target, it has no session there).
  station String?
  /// That session's label (its folder or title).
  label String?
  /// A cloud cook (a Claude routine, a GitHub mention, a webhook): fire and forget, each wake a fresh run that answers once.
  cloud Boolean?
}
