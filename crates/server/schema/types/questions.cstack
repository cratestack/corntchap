part of "../corntchap.cstack"

// The question pool.

type QuestionNote {
  author String?
  body String
  at String
}

/// One answer proposal of a question.
type QuestionChoice {
  /// Short slug, unique within the question; what an answer refers to.
  id String
  label String
  /// One line of context; cards usually have none.
  description String?
}

/// A task a question is linked to.
type QuestionTaskView {
  /// Task id, e.g. PAY-42.
  id String
  title String
  /// open, claimed, blocked, done or cancelled.
  status String
  /// The task waits on the answer while the question is open.
  blocks Boolean
  /// The question was asked on this task (not linked by hand); it never blocks.
  implicit Boolean
  /// Who linked it (or asked, when implicit).
  linked_by String?
}

/// A question in a pot's pool.
type QuestionView {
  /// Question id, e.g. PAY-Q3.
  id String
  project String
  /// The task it is about, e.g. PAY-42.
  task String?
  asked_by String?
  /// The station (session) that asked: the answer wakes it.
  station String?
  /// Addressed to this person or cook (else to the pot's people).
  to String?
  /// The title and the description together, for older readers.
  body String
  /// The short question, one line.
  title String
  /// Context, markdown (may be empty).
  description String
  /// single (radio), multiple (checkboxes), free (free-form text) or cards (radio cards).
  kind String
  /// The answer proposals, in order (empty for free).
  choices QuestionChoice[]
  /// single, multiple and cards: the answerer may type their own answer too.
  allow_other Boolean
  /// multiple: the fewest choices, when set.
  min Int?
  /// multiple: the most choices, when set.
  max Int?
  /// The labels of the choices, for older readers.
  options String[]
  /// The asker parked its task until the answer.
  wait Boolean
  /// open, answered or dismissed.
  status String
  /// The cook currently asking it in a chat (held for a few minutes).
  picked_by String?
  /// The answer as text ("Names only", "Names and SKUs, Prices, plus: also tags").
  answer String?
  /// The ids of the chosen choices.
  answer_choices String[]
  /// The typed answer: the whole answer of a free question, or the other answer.
  answer_text String?
  /// Who answered (for a relayed answer: the person, not the cook).
  answered_by String?
  /// The cook that relayed the answer from its owner's chat, if any.
  relayed_by String?
  answered_at String?
  created_at String
  updated_at String
  /// The tasks the question is linked to: the one it was asked on (implicit) and those linked with link_question.
  tasks QuestionTaskView[]
  /// Follow-ups in the question's thread.
  notes QuestionNote[]
  /// Files attached to the question (screenshots for the chef).
  files FileRef[]
}

/// What pick_question returns: a question to put to your owner, or none.
type PickedQuestion {
  question QuestionView?
  none Boolean?
}
