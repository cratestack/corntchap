part of "../corntchap.cstack"

// Outputs of the administration procedures: the same shapes /api/v1 returns.

/// A person who can sign in.
type UserView {
  name String
  /// How the person is shown (their name or e-mail at the identity provider); never used for lookup.
  display_name String?
  /// super_admin, orchestrator or member.
  role String
  /// Signed in at least once (linked to an identity).
  linked Boolean?
  disabled Boolean?
}

/// A team you can see.
type TeamView {
  name String
  /// Your role in it: owner or member (a chef; absent for super-admins who are not in it). An owner who is no longer an orchestrator keeps the row but not the powers.
  role String?
  /// How many chefs (people and cooks) it has.
  members Int
  /// Keys of the team's pots.
  projects String[]
}

type TeamCreated {
  id String
  name String
}

/// One of a team's chefs: a person or a cook.
type MemberView {
  name String
  /// How a person is shown (absent for cooks).
  display_name String?
  /// user or agent.
  kind String
  /// owner, or member (a chef).
  role String
  /// A cook with cloud wake targets only: it takes ready work, opens a pull request and stops.
  /// Do not message, ask or assign reviews to it; give it a task (its owner may message it).
  fireAndForget Boolean
}

type MemberAdded {
  team String
  principal String
  role String
}

type ProjectCreated {
  key String
  name String
  team String
  /// Lease length in seconds.
  lease_ttl_s Int
}

/// A cook (agent) or a fire (relay) you own (super-admins: all).
type PrincipalView {
  /// Principal id (the `principals` model's id: PATCH /api/v2/principals/{id} {maxLeases} changes a cook's limit).
  id String
  name String
  /// agent or relay.
  kind String
  /// claude-code, codex, opencode, copilot, antigravity or other (cooks).
  agent_kind String?
  /// local or cloud (cooks).
  runtime String?
  max_leases Int
  owner String?
  /// Cooks: plan, manage and/or admin, granted by a person.
  grants String[]
  /// Cooks: the repositories it handles per pot (a pot not listed: all of its repositories).
  repo_scopes CookRepoScope[]
  disabled Boolean
  last_seen_at String?
  /// Leases held right now.
  busy Int
  /// Teams it is in (its pots come from them).
  teams String[]
  /// A cook with cloud wake targets only: it takes ready work, opens a pull request and stops.
  /// Only its owner's direct messages wake it besides; give it a task.
  fireAndForget Boolean
}

/// A new cook or fire, or a rotated token. The token is shown once: treat it as a secret.
type PrincipalToken {
  name String
  kind String?
  agent_kind String?
  runtime String?
  /// Bearer token (ct_...), shown only here.
  token String
}

type EnabledView {
  name String
  disabled Boolean
}

/// How and when an idle cook is woken.
type WakeTargetView {
  id String
  /// relay, webhook, github-comment, claude-routine, coder or devin.
  type String
  /// Only wake for these pots (empty: all).
  projects String[]
  /// Only wake for tasks with these labels (empty: any).
  labels String[]
  /// Where it goes: the webhook URL or owner/repo#issue (secrets are never shown).
  target String?
}

type WakeTargetAdded {
  id String
  agent String
  type String
  /// claude-routine: the text to put in the routine's prompt, so each run acts on the corntchap wake.
  routine_prompt String?
}

type GrantsView {
  name String
  grants String[]
}

/// A cook, fire or team that was renamed.
type RenamedView {
  name String
  previous String
}

/// A pot that was renamed (its key never changes).
type PotRenamedView {
  key String
  name String
  previous String
}

/// A cook, fire or team that was deleted.
type DeletedView {
  name String
  /// Cooks: leases released (tasks put back to open) before it went.
  released Int
}

/// A pot that was deleted.
type PotDeletedView {
  key String
  name String
  /// Tasks that went with it.
  tasks Int
  /// Stored file objects removed from storage; `files_left` could not be (the metadata is gone either way).
  files Int
  files_left Int
}

/// The repositories a cook handles in one pot.
type CookRepoScope {
  project String
  repos String[]
}

/// A person's role after a change.
type RoleView {
  name String
  /// super_admin, orchestrator or member.
  role String
  /// manual: the identity provider no longer changes it.
  role_source String
  note String
}

/// A repository that sends forge events although no pot follows it.
type ForgeUnfollowedView {
  provider String
  /// owner/name.
  repo String
  url String
  installation Int?
  /// Events received so far.
  events Int
  first_seen String
  last_seen String
}
