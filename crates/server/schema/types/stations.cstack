part of "../corntchap.cstack"

// Stations: registered agent sessions.

/// One agent session registered for a cook in a pot: wakes resume this very session.
type StationView {
  /// Station id, e.g. st_1a2b3c4d5e: pass it as `station` to claim_next / claim_task / ask.
  id String
  cook String
  /// Pot key, e.g. PAY.
  project String
  /// opencode, claude-code, codex, copilot, antigravity or other; for a cloud run its target type (claude-routine, devin, coder, webhook, github-comment).
  runtime String
  /// The runtime's own session id.
  session String
  /// Where the session works (a checkout or a worktree) on the cook's machine.
  directory String?
  /// The pot's repository (alias) this folder is a checkout of, when known.
  repo String?
  label String?
  /// The session cannot leave its folder: claim_next hands it only tasks about its repo or about none.
  confined Boolean
  /// The pot's guide (how we work here), its first 1500 characters, on register_station's answer only.
  guide String?
  /// The cook's main station in this pot: the session that answers messages and mentions.
  main Boolean
  /// session (a registered agent session) or cloud-run (one station per cloud run: a Claude routine run, a Devin session, a Coder run, a webhook or GitHub-comment run).
  kind String
  /// The cloud run's own page (a Claude routine's session URL, a Devin session), when it has one.
  session_url String?
  /// A cloud run that holds nothing any more (its last task was released or completed, or it went quiet); a later call naming it reopens it.
  ended_at String?
  /// The wake target type of a cloud run: claude-routine, devin, coder, webhook or github-comment.
  target_type String?
  created_at String
  last_woken_at String?
  /// Tasks this station holds a live lease on.
  holding String[]
  /// Tasks parked on a question this station asked.
  waiting String[]
}
