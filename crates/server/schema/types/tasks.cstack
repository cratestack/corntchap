part of "../corntchap.cstack"

// Typed procedure outputs (MCP `outputSchema`, generated TypeScript types). Field names are the
// snake_case keys of the JSON the service layer has always returned; timestamps stay strings so
// the bytes on the wire do not change. Null-valued optionals are omitted by the framework.
//
// Task, lease and markdown views returned by the task procedures.

type TaskItemView {
  position Int
  text String
  done Boolean
  done_by String?
}

type TaskCommentView {
  author String?
  body String
  at String
  /// The session (station) that wrote it, when the cook said which.
  station String?
  station_label String?
}

type TaskLinkView {
  id String
  title String
  status String
}

/// A pull request attached to a task (forge events: README, "GitHub (and other forges)").
type PrView {
  provider String
  /// owner/name
  repo String
  number Int
  url String
  title String
  author String?
  /// open, closed or merged. A merge never changes the task's status.
  state String
  draft Boolean
  head_branch String
  /// pending, success, failure or none
  checks String
  /// Names of the failing checks.
  failing String[]
  checks_url String?
  /// approved, changes_requested, commented or none
  review String
  /// true, false (it has conflicts) or unknown
  mergeable String
  /// A person linked it by hand (not found from the branch or title).
  explicit Boolean
  updated_at String
}

/// The compact PR summary on a board card or list row.
type PrSummary {
  repo String
  number Int
  url String
  state String
  draft Boolean
  checks String
  review String
  /// The pull request has merge conflicts.
  conflict Boolean
  /// How many pull requests the task has.
  count Int
}

/// A task as lists show it.
type TaskView {
  /// Task id, e.g. PAY-42.
  id String
  project String
  number Int
  title String
  body String
  /// Higher is picked first by claim_next.
  priority Int
  labels String[]
  /// Aliases of the pot's repositories the task is about (empty: any repository).
  repos String[]
  /// open, claimed, blocked, done or cancelled (shown to people as "Tossed").
  status String
  /// Parent task id when this is a subtask.
  parent String?
  /// Task ids that must be done before this one is ready.
  depends_on String[]
  /// The agent holding the lease.
  claimed_by String?
  /// The station (agent session) that holds the lease or is parked on the task, e.g. st_1a2b3c4d.
  /// A cook with several stations touches only the leases of its own station.
  station String?
  /// The station that held the task last, once nobody holds it (released, lapsed, done):
  /// where to look for leftover work.
  last_station String?
  /// Fencing token of the current lease: pass it to every lease call; a newer claim makes older epochs stale.
  lease_epoch Int
  /// When the lease lapses unless extended (RFC 3339).
  lease_expires_at String?
  /// The task is claimed and its lease has not expired.
  lease_live Boolean?
  /// Open, with every dependency and subtask done: claim_next may hand it out.
  ready Boolean?
  /// Unticked checklist items.
  open_items Int
  total_items Int
  /// The menu (milestone) key the task is on, e.g. mvp.
  menu String?
  /// The summary passed to complete.
  result String?
  created_at String
  updated_at String
  /// The task's pull request (the open one first), when it has any.
  pr PrSummary?
}

/// A task with its checklist, comments, dependencies and subtasks.
type TaskDetail {
  /// Task id, e.g. PAY-42.
  id String
  project String
  number Int
  title String
  body String
  /// Higher is picked first by claim_next.
  priority Int
  labels String[]
  /// Aliases of the pot's repositories the task is about (empty: any repository).
  repos String[]
  /// open, claimed, blocked, done or cancelled (shown to people as "Tossed").
  status String
  /// Parent task id when this is a subtask.
  parent String?
  /// Task ids that must be done before this one is ready.
  depends_on String[]
  /// The agent holding the lease.
  claimed_by String?
  /// The station (agent session) that holds the lease or is parked on the task, e.g. st_1a2b3c4d.
  /// A cook with several stations touches only the leases of its own station.
  station String?
  /// The station that held the task last, once nobody holds it (released, lapsed, done):
  /// where to look for leftover work.
  last_station String?
  /// Fencing token of the current lease: pass it to every lease call; a newer claim makes older epochs stale.
  lease_epoch Int
  /// When the lease lapses unless extended (RFC 3339).
  lease_expires_at String?
  /// The task is claimed and its lease has not expired.
  lease_live Boolean?
  /// Open, with every dependency and subtask done: claim_next may hand it out.
  ready Boolean?
  /// Unticked checklist items.
  open_items Int
  total_items Int
  /// The menu (milestone) key the task is on, e.g. mvp.
  menu String?
  /// The summary passed to complete.
  result String?
  created_at String
  updated_at String
  /// The task's pull request (the open one first), when it has any.
  pr PrSummary?
  /// Every pull request linked to the task, the open ones first.
  prs PrView[]
  items TaskItemView[]
  comments TaskCommentView[]
  dependencies TaskLinkView[]
  subtasks TaskLinkView[]
  /// Files attached to the task (get_file for a download URL; links: /files/<id>/<name>).
  files FileRef[]
}

type LeaseView {
  epoch Int
  expires_at String
}

/// The lease before yours, when it lapsed instead of ending.
type PreviousLease {
  /// The cook that held it.
  holder String?
  /// Its station, e.g. st_1a2b3c4d.
  station String?
  lapsed_at String
  /// It was your own lease.
  yours Boolean
}

/// What claim_next / claim_task return.
type ClaimResult {
  task TaskDetail?
  /// Your lease: keep the epoch, every lease call needs it.
  lease LeaseView?
  /// Nothing is ready for you right now.
  none Boolean?
  /// Read before you start: the task is about repositories outside your scope or has an open
  /// pull request (claim_task, it was still given to you), or its last lease lapsed without a
  /// release (see previous_lease).
  warning String?
  /// The task's last lease ran out without a release, block or completion: its work may still
  /// sit in that holder's branch or worktree, or in an open pull request.
  previous_lease PreviousLease?
  /// With none: the tasks you released a moment ago (comma-separated, e.g. PAY-3,PAY-7), which
  /// claim_next leaves to the other cooks for now (claim_task takes one back by name).
  released_recently String?
  /// With none: open tasks with an open pull request (comma-separated, e.g. PAY-4 (acme/web#12)):
  /// waiting on CI or review, so claim_next does not hand them out.
  open_prs String?
  /// With none: what to do about released_recently and open_prs.
  hint String?
  /// What was saved or changed in the pot's pantry since you last read it: read those memories
  /// (get_memory) before you start. Absent when there is nothing new.
  pantry PantryNews?
}

type PantryNewsItem {
  key String
  title String
  /// The memory's kind, or "removed" for a memory deleted since.
  kind String
  by String?
  updated_at String
  /// The memory was removed: stop relying on it.
  deleted Boolean
}

type PantryNews {
  /// How many memories are new or changed since you last read the pantry.
  count Int
  /// The 10 most recent of them.
  items PantryNewsItem[]
}

type LeaseRenewal {
  id String
  epoch Int
  expires_at String
}

type MarkdownDoc {
  markdown String
}

type OkResult {
  ok Boolean
}

type PotLease {
  /// Pot key.
  key String
  /// The pot's default lease length, in seconds.
  lease_ttl_s Int
}

/// What split_by_repo returns.
type SplitResult {
  /// The task that was split: it now waits for its subtasks.
  parent TaskDetail
  /// The subtasks created now (none when every repository already had its part).
  subtasks TaskView[]
}
