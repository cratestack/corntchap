part of "../corntchap.cstack"

// Typed procedure outputs (MCP `outputSchema`, generated TypeScript types). Field names are the
// snake_case keys of the JSON the service layer has always returned; timestamps stay strings so
// the bytes on the wire do not change. Null-valued optionals are omitted by the framework.
//
// Task, lease and markdown views returned by the task procedures.

type TaskItemView {
  position Int
  text String
  done Boolean
  done_by String?
}

type TaskCommentView {
  author String?
  body String
  at String
  /// The session (station) that wrote it, when the cook said which.
  station String?
  station_label String?
  /// The station's session page (a cloud run's URL), when it has one.
  station_url String?
}

type TaskLinkView {
  id String
  title String
  status String
}

/// A pull request attached to a task (forge events: README, "GitHub (and other forges)").
type PrView {
  provider String
  /// owner/name
  repo String
  number Int
  url String
  title String
  author String?
  /// open, closed or merged. A merge never changes the task's status.
  state String
  draft Boolean
  head_branch String
  /// pending, success, failure or none
  checks String
  /// Names of the failing checks.
  failing String[]
  checks_url String?
  /// approved, changes_requested, commented or none
  review String
  /// true, false (it has conflicts) or unknown
  mergeable String
  /// A person linked it by hand (not found from the branch or title).
  explicit Boolean
  /// The station (cloud run or session) that linked it, when its cook held the task.
  station String?
  station_label String?
  station_url String?
  updated_at String
}

/// The compact PR summary on a board card or list row.
type PrSummary {
  repo String
  number Int
  url String
  state String
  draft Boolean
  checks String
  review String
  /// The pull request has merge conflicts.
  conflict Boolean
  /// How many pull requests the task has.
  count Int
}

/// A task as lists show it.
type TaskView {
  /// Task id, e.g. PAY-42.
  id String
  project String
  number Int
  title String
  body String
  /// Higher is picked first by claim_next.
  priority Int
  labels String[]
  /// Aliases of the pot's repositories the task is about (empty: any repository).
  repos String[]
  /// open, claimed, blocked, done or cancelled (shown to people as "Tossed").
  status String
  /// Parent task id when this is a subtask.
  parent String?
  /// Task ids that must be done before this one is ready.
  depends_on String[]
  /// The agent holding the lease.
  claimed_by String?
  /// The task's owner: the person (or cook) accountable for it, whoever does the work (a handle).
  owner String?
  /// The station (agent session) that holds the lease or is parked on the task, e.g. st_1a2b3c4d.
  /// A cook with several stations touches only the leases of its own station.
  station String?
  /// The station that held the task last, once nobody holds it (released, lapsed, done):
  /// where to look for leftover work.
  last_station String?
  /// The session page of the station (a cloud run's session URL), when it has one.
  station_url String?
  last_station_url String?
  /// Fencing token of the current lease: pass it to every lease call; a newer claim makes older epochs stale.
  lease_epoch Int
  /// When the lease lapses unless extended (RFC 3339).
  lease_expires_at String?
  /// The task is claimed and its lease has not expired.
  lease_live Boolean?
  /// Open, with every dependency and subtask done: claim_next may hand it out.
  ready Boolean?
  /// Unticked checklist items.
  open_items Int
  total_items Int
  /// The menu (milestone) key the task is on, e.g. mvp.
  menu String?
  /// The summary passed to complete.
  result String?
  created_at String
  updated_at String
  /// The task's pull request (the open one first), when it has any.
  pr PrSummary?
  /// The latest review round (a cook or person looked at the work), when there is one. GitHub's own reviews are in `pr`.
  review ReviewSummary?
}

/// A task with its checklist, comments, dependencies and subtasks.
type TaskDetail {
  /// Task id, e.g. PAY-42.
  id String
  project String
  number Int
  title String
  body String
  /// Higher is picked first by claim_next.
  priority Int
  labels String[]
  /// Aliases of the pot's repositories the task is about (empty: any repository).
  repos String[]
  /// open, claimed, blocked, done or cancelled (shown to people as "Tossed").
  status String
  /// Parent task id when this is a subtask.
  parent String?
  /// Task ids that must be done before this one is ready.
  depends_on String[]
  /// The agent holding the lease.
  claimed_by String?
  /// The task's owner: the person (or cook) accountable for it, whoever does the work (a handle).
  owner String?
  /// The station (agent session) that holds the lease or is parked on the task, e.g. st_1a2b3c4d.
  /// A cook with several stations touches only the leases of its own station.
  station String?
  /// The station that held the task last, once nobody holds it (released, lapsed, done):
  /// where to look for leftover work.
  last_station String?
  /// The session page of the station (a cloud run's session URL), when it has one.
  station_url String?
  last_station_url String?
  /// Fencing token of the current lease: pass it to every lease call; a newer claim makes older epochs stale.
  lease_epoch Int
  /// When the lease lapses unless extended (RFC 3339).
  lease_expires_at String?
  /// The task is claimed and its lease has not expired.
  lease_live Boolean?
  /// Open, with every dependency and subtask done: claim_next may hand it out.
  ready Boolean?
  /// Unticked checklist items.
  open_items Int
  total_items Int
  /// The menu (milestone) key the task is on, e.g. mvp.
  menu String?
  /// The summary passed to complete.
  result String?
  created_at String
  updated_at String
  /// The task's pull request (the open one first), when it has any.
  pr PrSummary?
  /// The latest review round (a cook or person looked at the work), when there is one. GitHub's own reviews are in `pr`.
  review ReviewSummary?
  /// Every pull request linked to the task, the open ones first.
  prs PrView[]
  /// Every review round of the task, oldest first.
  reviews ReviewView[]
  /// Set by link_pr and refresh_pr when GitHub could not be read (the app is not installed on the repository): the pull request's data stays empty.
  warning String?
  items TaskItemView[]
  comments TaskCommentView[]
  dependencies TaskLinkView[]
  subtasks TaskLinkView[]
  /// Files attached to the task (get_file for a download URL; links: /files/<id>/<name>).
  files FileRef[]
}

type LeaseView {
  epoch Int
  expires_at String
  /// When the server ends the lease whatever its expiry: STALL_MINUTES (default 120) after your last
  /// progress (a comment, a ticked item, an update, a question, a saved memory; heartbeats are not
  /// progress), or MAX_HOLD_HOURS (default 8) after the claim, whichever comes first.
  stalls_at String?
  /// Under 20 minutes before stalls_at: what to do (comment or tick an item, or finish).
  warning String?
}

/// The lease before yours, when it lapsed instead of ending.
type PreviousLease {
  /// The cook that held it.
  holder String?
  /// Its station, e.g. st_1a2b3c4d.
  station String?
  lapsed_at String
  /// It was your own lease.
  yours Boolean
}

/// What claim_next / claim_task return.
type ClaimResult {
  task TaskDetail?
  /// Your lease: keep the epoch, every lease call needs it.
  lease LeaseView?
  /// Nothing is ready for you right now.
  none Boolean?
  /// Read before you start: the task is about repositories outside your scope or has an open
  /// pull request (claim_task, it was still given to you), or its last lease lapsed without a
  /// release (see previous_lease).
  warning String?
  /// The task's last lease ran out without a release, block or completion: its work may still
  /// sit in that holder's branch or worktree, or in an open pull request.
  previous_lease PreviousLease?
  /// With none: the tasks you released a moment ago (comma-separated, e.g. PAY-3,PAY-7), which
  /// claim_next leaves to the other cooks for now (claim_task takes one back by name).
  released_recently String?
  /// With none: open tasks with an open pull request (comma-separated, e.g. PAY-4 (acme/web#12)):
  /// waiting on CI or review, so claim_next does not hand them out.
  open_prs String?
  /// With none: what to do about released_recently and open_prs.
  hint String?
  /// With none: tasks you gave back 3 times with nobody touching them since (comma-separated):
  /// claim_next skips them and claim_task refuses them until someone comments, edits or answers.
  bounced String?
  /// What was saved or changed in the pot's pantry since you last read it: read those memories
  /// (get_memory) before you start. Absent when there is nothing new.
  pantry PantryNews?
  /// The pantry memories most relevant to the task (at most 5): learned on it, its parent or its
  /// dependencies, tagged like it, the pot's conventions and gotchas, or sharing words with its title.
  memories RelevantMemory[]
  /// You were away (30 minutes or more) and have not been briefed on this pot: no lease was
  /// taken, this is what you missed. Read it, then claim again. This is not `none`.
  catch_up CatchUp?
  /// With catch_up: what to do next.
  next String?
}

/// A pantry memory offered with a claim.
type RelevantMemory {
  key String
  title String
  kind String
  /// The start of its body (240 characters); get_memory reads it whole.
  excerpt String
}

type CatchUpCount {
  kind String
  count Int
}

/// What happened in the pot while you were away.
type CatchUpChanges {
  total Int
  /// Events by kind, most frequent first.
  counts CatchUpCount[]
  /// The latest events, newest first: time, who, kind, task.
  recent String[]
}

/// The briefing an agent gets on its first claim in a pot after an absence.
type CatchUp {
  project String
  /// How long you were away, e.g. "2 h 5 min".
  away_for String
  away_since String?
  changes CatchUpChanges
  /// Tasks you still hold with a live lease.
  holding NowTask[]
  /// Blocked tasks parked for you.
  parked NowTask[]
  waiting_on_you NowWaiting
  /// Pass messages you have not read (read_pass).
  unread_pass Int
  /// Pantry changes since you last read it.
  pantry_news Int
  /// The pot's conventions and gotchas (at most 5).
  memories RelevantMemory[]
}

type PantryNewsItem {
  key String
  title String
  /// The memory's kind, or "removed" for a memory deleted since.
  kind String
  by String?
  updated_at String
  /// The memory was removed: stop relying on it.
  deleted Boolean
}

type PantryNews {
  /// How many memories are new or changed since you last read the pantry.
  count Int
  /// The 10 most recent of them.
  items PantryNewsItem[]
}

type LeaseRenewal {
  id String
  epoch Int
  expires_at String
  /// When the server ends the lease whatever its expiry (see LeaseView).
  stalls_at String?
  /// Under 20 minutes before stalls_at: what to do.
  warning String?
}

type MarkdownDoc {
  markdown String
}

type OkResult {
  ok Boolean
}

/// A comment was added.
type CommentPosted {
  ok Boolean
  /// The cooks it woke.
  woken String[]
  /// Set when a fire-and-forget cook it reached was not woken: it only takes ready work.
  note String?
}

type PotLease {
  /// Pot key.
  key String
  /// The pot's default lease length, in seconds.
  lease_ttl_s Int
}

/// What split_by_repo returns.
type SplitResult {
  /// The task that was split: it now waits for its subtasks.
  parent TaskDetail
  /// The subtasks created now (none when every repository already had its part).
  subtasks TaskView[]
}
