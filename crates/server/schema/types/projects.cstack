part of "../corntchap.cstack"

// Project, identity and team views.

type ProjectSummary {
  key String
  name String
  repo_url String?
  team String?
  lease_ttl_s Float
  open Int
  ready Int
  claimed Int
  blocked Int
  done Int
  /// Tasks tossed (status cancelled).
  tossed Int
  /// Questions waiting for an answer in the pot's pool.
  open_questions Int
  /// Messages you have not read on the pot's pass and in your direct conversations there.
  unread_pass Int
}

type TeamRole {
  name String
  role String
}

type WhoamiView {
  name String
  /// How a person is shown (from the identity provider); absent for cooks and fires.
  display_name String?
  kind String
  agent_kind String?
  runtime String?
  is_admin Boolean
  max_leases Int
  /// Cooks: what your owner granted beyond working tasks (plan, manage, admin).
  grants String[]
  teams TeamRole[]
  projects String[]
  current_leases TaskView[]
}
