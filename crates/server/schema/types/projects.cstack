part of "../corntchap.cstack"

// Project, identity and team views.

type ProjectSummary {
  key String
  name String
  /// The first repository's url (kept for old clients; see repos).
  repo_url String?
  /// The pot's repositories, first added first. Empty: the pot has none.
  repos RepoView[]
  team String?
  lease_ttl_s Float
  /// The pot's guide (how we work here, markdown), whole.
  guide String?
  open Int
  ready Int
  claimed Int
  blocked Int
  done Int
  /// Tasks tossed (status cancelled).
  tossed Int
  /// Questions waiting for an answer in the pot's pool.
  open_questions Int
  /// Reviews waiting on the caller (named to them, or to anyone when they did not ask).
  waiting_reviews Int
  /// Messages you have not read on the pot's pass and in your direct conversations there.
  unread_pass Int
}

type TeamRole {
  name String
  role String
}

type WhoamiView {
  name String
  /// How a person is shown (from the identity provider); absent for cooks and fires.
  display_name String?
  kind String
  agent_kind String?
  runtime String?
  /// Your role: super_admin, orchestrator or member (cooks are always members: they act through their owner).
  role String
  max_leases Int
  /// Cooks: what your owner granted beyond working tasks (plan, manage, admin).
  grants String[]
  teams TeamRole[]
  projects String[]
  current_leases TaskView[]
  /// The first 1500 characters of the guide of the pot in scope (how we work here); read the rest with what_now.
  guide String?
}

/// One of a pot's repositories.
type RepoView {
  /// The short alias tasks and cooks use, e.g. backend.
  name String
  url String
  default_branch String?
  /// Repositories of the pot this one depends on: serving a task in one of them tells this one's cooks.
  depends_on RepoLinkView[]
}

/// A dependency of one repository on another.
type RepoLinkView {
  /// The repository depended on.
  name String
  /// notify (tell the cooks scoped to the dependent) or task (open a follow-up task).
  mode String
}

/// A pot's repositories.
type ReposView {
  project String
  repos RepoView[]
}

type RepoAdded {
  project String
  added RepoView
  repos RepoView[]
}

type RepoRemoved {
  project String
  removed String
  repos RepoView[]
}

/// The repositories a cook handles in a pot.
type CookReposView {
  cook String
  project String
  /// Aliases; empty means all of the pot's repositories.
  repos String[]
}

/// A repository a connected GitHub App can see.
type ForgeRepoView {
  /// owner/name.
  full_name String
  html_url String
  clone_url String
  default_branch String?
  private Boolean
  archived Boolean
  description String?
  /// RFC 3339.
  pushed_at String?
  /// The account the app is installed on.
  account String
  installation Int
  /// Already one of the pot's repositories.
  in_pot Boolean
  /// Its alias in the pot when in_pot.
  pot_name String?
  /// The alias add_repos would give it.
  suggested_name String
  /// How many events this repository sent that no pot followed (it is in no pot): add it to one.
  unfollowed_events Int?
}

/// The repositories a pot could add from GitHub.
type ForgeRepos {
  project String?
  /// False when no GitHub App that can list repositories is connected.
  connected Boolean
  total Int
  repos ForgeRepoView[]
  /// One message per installation that could not be listed.
  errors String[]
}

type RepoSkipped {
  input String
  reason String
}

type ReposAdded {
  project String
  added RepoView[]
  skipped RepoSkipped[]
  repos RepoView[]
}
