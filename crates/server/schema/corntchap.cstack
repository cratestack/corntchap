// corntchap: agent coordination. Every MCP tool is a procedure here; the REST surface
// in src/rest.rs calls the same service functions, so the two cannot disagree.

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

mcp {
  name = "corntchap"
  expose = [tools, resources]
}

auth Caller {
  id String
  name String
  kind String
  isAdmin Boolean
  maxLeases Int
  ownerId String?
  runtime String?
  agentKind String?
}

// The schema is split into parts by concern; each one declares `part of` this file.
//   types/       typed procedure outputs (MCP outputSchema, generated TypeScript types)
//   procedures/  MCP tools and console actions
//   models/      the generated REST surface (/api/v2), policies and MCP resources

part "types/tasks.cstack"
part "types/projects.cstack"
part "types/feed.cstack"
part "types/memory.cstack"
part "types/menus.cstack"
part "procedures/reads.cstack"
part "procedures/tasks.cstack"
part "procedures/feed.cstack"
part "procedures/human.cstack"
part "procedures/memory.cstack"
part "procedures/menus.cstack"
part "models/people.cstack"
part "models/work.cstack"
part "models/runtime.cstack"
part "models/memory.cstack"
