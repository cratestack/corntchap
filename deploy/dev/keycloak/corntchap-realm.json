      "enabled": true,
      "email": "admin@corntchap.test",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "corntchap-admin"
      ]
    },
    {
      "id": "0b8e6f0a-1c2d-4e3f-9a5b-7c6d5e4f3a02", "username": "dev",
      "enabled": true,
      "email": "dev@corntchap.test",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
